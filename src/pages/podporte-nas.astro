---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { config } from '../config';
import { url } from '../lib/url';
const s = (await getEntry('stranky', 'podporte-nas'))!;
const { Content } = await render(s);
const stav = { 'v-prodeji': 'V prodeji', pripravujeme: 'Připravujeme', 'na-akcich': 'Potkáte na akcích' } as const;
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <section class="container section">
    <SectionHeading as="h1" label="PODPOŘTE NÁS" spines>Festival žije díky vám</SectionHeading>
    <div class="prose"><Content /></div>
    <p class="cta">
      <a class="btn" href={`mailto:${config.email}?subject=Chci se přidat k dobrovolníkům`}>Chci být dobrovolník</a>
      <a class="btn btn--ghost" href={url('/partneri/')}>Partneři festivalu</a>
    </p>
  </section>

  <section class="container section">
    <SectionHeading label="ČTUPOMÍNKOVÉ PŘEDMĚTY">Odneste si kus festivalu</SectionHeading>
    <ul class="grid-cards" role="list">
      {s.data.polozky.map((p) => (
        <li class="card predmet">
          <p class="label label--accent">{stav[p.stav]}</p>
          <h3>{p.nazev}<span class="dot">.</span></h3>
          <p>{p.text}</p>
          {(p.cena || p.kde) && <p class="predmet__kde"><strong>{p.cena}</strong>{p.cena && p.kde && ' · '}{p.kde}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="container section">
    <div class="poukazka" role="img" aria-label="Poukázka: Dvě hodiny nerušeného čtení jsou vaše.">
      <p class="label">poukázka</p>
      <p class="poukazka__text">Dvě hodiny nerušeného čtení jsou vaše<span class="dot">.</span></p>
    </div>
  </section>
</BaseLayout>

<style>
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .predmet h3 { margin-bottom: var(--space-2); }
  .predmet__kde { margin: 0; }
  .poukazka {
    border: 2px dashed var(--accent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    max-width: 40rem;
    transform: rotate(-2deg);
  }
  .poukazka__text { font-family: var(--font-head); font-weight: 700; font-size: var(--fs-h2); line-height: 1.05; margin: 0; }
</style>
