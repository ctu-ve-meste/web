---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextPanel from '../components/TextPanel.astro';
import SectionHeading from '../components/SectionHeading.astro';
const s = (await getEntry('stranky', 'ochrana-osobnich-udaju'))!;
const { Content } = await render(s);
import { config } from '../config';
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <article class="container section">
    <SectionHeading as="h1" label="GDPR" spines>Ochrana osobních údajů</SectionHeading>
    <TextPanel>
      <div class="prose"><Content /></div>
      <Fragment slot="panel">
        <p class="label label--accent">Dotazy</p>
        <p>{config.spolek.nazev}<br />{config.spolek.ulice}, {config.spolek.psc} {config.spolek.mesto}<br />IČ {config.spolek.ico}</p>
        <p><a href={`mailto:${config.email}`}>{config.email}</a></p>
      </Fragment>
    </TextPanel>
  </article>
</BaseLayout>
