---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { config } from '../config';
import { url } from '../lib/url';
import Kopirovat from '../components/Kopirovat.astro';
const stranka = (await getEntry('stranky', 'partneri'))!;
const { Content } = await render(stranka);
const partneri = (await getCollection('partneri')).sort((a, b) => a.data.poradi - b.data.poradi);
---
<BaseLayout title="Partneři" description="Partneři festivalu Čtu ve městě. Děkujeme.">
  <section class="container section">
    <SectionHeading as="h1" label="PARTNEŘI" spines>Děkujeme</SectionHeading>
    <div class="prose"><Content /></div>
    <ul class="partneri" role="list">
      {partneri.map((p) => (
        <li>
          <a href={p.data.url} rel="noopener" class:list={{ 's-logem': p.data.logo }}>
            {p.data.logo ? <Image src={p.data.logo} alt={p.data.nazev} width={360} /> : <span>{p.data.nazev}</span>}
          </a>
        </li>
      ))}
    </ul>
    <p class="lead">Chcete se stát také partnerem? Ozvěte se nám.</p>
    <p><a class="btn" href={url(`/kontakt/?tema=${encodeURIComponent('Partnerství a podpora')}`)}>Chci vás podpořit</a></p>
    <p class="muted">E-mail: <Kopirovat text={config.email} odkaz={`mailto:${config.email}?subject=Chci vás podpořit`} /></p>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--fs-lead); }
  .partneri { list-style: none; padding: 0; margin: var(--space-5) 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .partneri a { display: flex; align-items: center; justify-content: center; min-height: 7rem; padding: var(--space-3); border: var(--border); border-radius: var(--radius-card); background: var(--gray-1); text-align: center; font-family: var(--font-head); font-weight: 700; text-decoration: none; }
  .partneri a.s-logem { background: #fff; }
  .partneri a.s-logem img { width: auto; max-width: 100%; max-height: 4.5rem; height: auto; object-fit: contain; }
</style>
