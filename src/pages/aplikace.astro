---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { config } from '../config';
const s = (await getEntry('stranky', 'aplikace'))!;
const { Content } = await render(s);
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <article class="container section">
    <SectionHeading as="h1" label="APLIKACE" spines>Knižní seznamka a deník</SectionHeading>
    <p class="lead prose">Objevujte nové příběhy, vytvořte si seznam knih k přečtení a nechte se motivovat k tomu, abyste četli každý den.</p>
    <p><a class="btn" href={config.site.aplikace} rel="noopener">Stáhnout na Google Play</a></p>
    <div class="prose"><Content /></div>
    <p><a class="btn" href={config.site.aplikace} rel="noopener">Stáhnout na Google Play</a></p>
  </article>
</BaseLayout>
