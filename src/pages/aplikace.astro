---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextPanel from '../components/TextPanel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { config } from '../config';
const s = (await getEntry('stranky', 'aplikace'))!;
const { Content } = await render(s);
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import seznamka from '../assets/aplikace/seznamka.png';
import mapa from '../assets/aplikace/mapa.png';
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <article class="container section">
    <SectionHeading as="h1" label="APLIKACE" spines>Knižní seznamka a deník</SectionHeading>
    <TextPanel>
      <p class="lead">Objevujte nové příběhy, vytvořte si seznam knih k přečtení a nechte se motivovat k tomu, abyste četli každý den.</p>
      <p class="jen-mobil"><a class="btn" href={config.site.aplikace} rel="noopener">Stáhnout na Google Play</a></p>
      <div class="prose"><Content /></div>
      <Fragment slot="panel">
        <a class="btn" href={config.site.aplikace} rel="noopener">Stáhnout na Google Play</a>
        <p class="muted small">Aplikace je zatím ke stažení na Google Play (Android).</p>
        <p class="small"><a href={url('/aplikace/podminky/')}>Podmínky použití</a> · <a href={url('/aplikace/ochrana-soukromi/')}>Ochrana soukromí</a></p>
      </Fragment>
    </TextPanel>
    <ul class="snimky" role="list">
      <li><Image src={seznamka} alt="Knižní seznamka v aplikaci: karta s obálkou knihy, kterou lze odsunout doleva, nebo uložit doprava" width={300} /><span class="muted small">Knižní seznamka</span></li>
      <li><Image src={mapa} alt="Mapa Frýdku-Místku s body festivalových akcí podle ročníků a detailem akce Čtení na Svobodě" width={300} /><span class="muted small">Mapa akcí</span></li>
    </ul>
  </article>
</BaseLayout>

<style>
  .snimky { list-style: none; padding: 0; margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; }
  .snimky li { display: grid; gap: var(--space-2); justify-items: center; width: min(45%, 15rem); }
  .snimky img { width: 100%; height: auto; }
  .small { font-size: var(--fs-small); }
  @media (min-width: 64rem) { .jen-mobil { display: none; } }
</style>
