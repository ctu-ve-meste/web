---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import { vsechnyAkce, chronologicky } from '../lib/akce';
import { aktualniRocnik } from '../lib/rocniky';
import { datumDlouze, rozsah, isoDatum } from '../lib/datum';
import { url } from '../lib/url';

const rocnik = await aktualniRocnik();
const r = rocnik.data;
const akce = chronologicky((await vsechnyAkce()).filter((a) => a.data.rocnik?.id === rocnik.id));
const dny = new Map<string, typeof akce>();
for (const a of akce) {
  const k = isoDatum(a.data.date);
  dny.set(k, [...(dny.get(k) ?? []), a]);
}
---
<BaseLayout title={`Program ${r.rok}`} description={`Program ${r.cislo}. ročníku festivalu Čtu ve městě ${r.rok}.`}>
  <section class="container section">
    <SectionHeading as="h1" label={`${r.cislo}. ROČNÍK · ${r.rok}`} spines>Program</SectionHeading>
    {r.od && <p class="lead">{rozsah(r.od, r.do)}</p>}

    {akce.length === 0 ? (
      <div class="prazdno">
        <p class="lead">
          {r.cislo}. ročník {r.rok} se připravuje.
          {r.od ? ` Těšte se na ${rozsah(r.od, r.do)}.` : ' Termín brzy oznámíme.'}
        </p>
        <p>Program zveřejníme v létě. Chcete ho mít mezi prvními?</p>
        <p><a class="btn" href={url('/newsletter/')}>Přihlaste se k newsletteru</a></p>
        <p class="muted">Mezitím se podívejte, <a href={url('/akce/')}>co všechno už proběhlo</a>.</p>
      </div>
    ) : (
      [...dny.entries()].map(([den, seznam]) => (
        <section class="den" aria-labelledby={`den-${den}`}>
          <h2 id={`den-${den}`} class="den__nadpis">{datumDlouze(seznam[0].data.date, false)}<span class="dot">.</span></h2>
          <ul class="grid" role="list">
            {seznam.map((a) => <li><EventCard akce={a} /></li>)}
          </ul>
        </section>
      ))
    )}
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--fs-lead); }
  .prazdno { max-width: var(--max-w-text); }
  .den { margin-top: var(--space-5); }
  .den__nadpis { font-size: var(--fs-h3); text-transform: capitalize; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
