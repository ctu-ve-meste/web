---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { url } from '../../lib/url';
const s = (await getEntry('stranky', 'aplikace-ochrana-soukromi'))!;
const { Content } = await render(s);
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <article class="container section">
    <p class="label muted"><a href={url('/aplikace/')}>Aplikace</a></p>
    <SectionHeading as="h1" label="OCHRANA SOUKROMÍ">Zásady ochrany osobních údajů</SectionHeading>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
