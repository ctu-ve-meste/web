---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextPanel from '../components/TextPanel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Chat from '../components/Chat.astro';
import { url } from '../lib/url';
const s = (await getEntry('stranky', 'kdo-jsme'))!;
const { Content } = await render(s);
const fotka = (await getEntry('rocniky', '2026'))!.data.fotky[8];
const lide = (await getCollection('dobrovolnici')).sort((a, b) => a.data.poradi - b.data.poradi);
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <section class="container section">
    <SectionHeading as="h1" label="KDO JSME" spines>Lidi z města</SectionHeading>
    <TextPanel fotka={fotka}>
      <div class="prose lead"><Content /></div>
      <Fragment slot="panel">
        <p class="label label--accent">Co nás drží pohromadě</p>
        <a class="btn btn--ghost" href={url('/manifest/')}>Přečtěte si manifest</a>
      </Fragment>
    </TextPanel>
  </section>

  <section class="container section pribeh reveal">
    <div>
      <SectionHeading label="JAK TO VZNIKLO">Jednou zprávou</SectionHeading>
      <p class="prose">
        Festival vznikl jednou zprávou. Jan Becher z knihkupectví Kapitola napsal branding designérovi Marku Vlčkovi.
      </p>
      <p class="prose muted">
        V roce 2024 to začalo bez rozpočtu a bez instituce — jen knihkupec, designér a chuť udělat čtení ve městě viditelné.
      </p>
      <p class="prose">Ještě před prvním ročníkem, v létě 2024, popsal Jan pro Deník, o co festivalu jde:</p>
      <blockquote class="citat">„Dostat lidi ven do ulic, aby se tam bavili a bavili i mezi sebou navzájem, i když se neznají.“</blockquote>
      <blockquote class="citat">„Mladším ukázat, že čtení je ‚cool‘ a starším připomenout, že čtení pro ně bylo ‚cool‘, ale třeba už na to zapomněli…“</blockquote>
      <p class="prose muted">Tehdy už se přihlásilo 30 dobrovolníků a tiskárna nabídla, že plakáty vytiskne zdarma.</p>
    </div>
    <Chat
      popis="Konverzace Jana Bechera a Marka Vlčka, kterou festival vznikl"
      zpravy={[
        { od: 'levy', jmeno: 'Jan Becher · knihkupectví Kapitola', text: 'Ahoj Máro,' },
        { od: 'levy', text: 'Mám pro tebe báječnou nabídku! Chtěl bys dělat vizuál pro čtenářský festival ve F‑M?' },
        { od: 'pravy', jmeno: 'Marek Vlček · branding designer', text: 'Tyyjoo jsem poctěn' },
        { od: 'levy', text: 'Komplet — logo, plakáty, socky, merch…' },
        { od: 'levy', text: 'A to nejlepší na konec: bylo by to zadarmo! 😀' },
        { od: 'pravy', text: 'To je skvělá výzva' },
        { od: 'levy', text: 'Ok, zavolám ti' },
      ]}
    />
  </section>

  <section class="container section reveal">
    <SectionHeading label="NAŠE PARTA DOBROVOLNÍKŮ">Kdo festival staví</SectionHeading>
    <ul class="grid-cards" role="list">
      {lide.map((l) => (
        <li class="card">
          {l.data.foto && <Image src={l.data.foto} alt="" width={400} class="foto" />}
          <h3>{l.data.jmeno}</h3>
          <p>{l.data.popis}</p>
        </li>
      ))}
    </ul>
    <p class="muted pozn">Tým se schází v knihkupectví Kapitola, kde vymýšlí další akce.</p>
  </section>
</BaseLayout>

<style>
  .citat { margin: var(--space-3) 0; padding-left: var(--space-3); border-left: 4px solid var(--accent); font-family: var(--font-head); font-size: var(--fs-lead); max-width: 36rem; }
  .pozn { margin-top: var(--space-4); }
  .pribeh { display: grid; gap: var(--space-5); }
  .foto { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: var(--space-3); }
  @media (min-width: 64rem) { .pribeh { grid-template-columns: 1fr 1fr; align-items: start; } }
</style>
