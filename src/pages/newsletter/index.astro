---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { config } from '../../config';
const s = (await getEntry('stranky', 'newsletter'))!;
const { Content } = await render(s);
---
<BaseLayout title={s.data.title} description={s.data.description}>
  <section class="container section">
    <SectionHeading as="h1" label="NEWSLETTER" spines>Brzy načtenou</SectionHeading>
    {config.appsScriptUrl ? (
      <div class="prose lead"><Content /></div>
    ) : (
      <p class="prose lead">Jednou za čas vám pošleme, co chystáme: program festivalu, nové akce během roku a pozvánky. Novinky najdete i na <a href={config.site.instagram} rel="noopener">Instagramu</a>.</p>
    )}
    <NewsletterForm />
  </section>
</BaseLayout>
