---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { config } from '../../config';
import { url } from '../../lib/url';
---
<BaseLayout title="Potvrzení odběru" noindex>
  <section class="container section prose">
    <SectionHeading as="h1" label="NEWSLETTER">Potvrzení odběru</SectionHeading>
    <p class="lead" data-stav data-email={config.email} data-url={config.appsScriptUrl} data-akce="potvrzeni" data-ok="Hotovo, odběr je potvrzený. Brzy načtenou!" role="status" aria-live="polite">Moment, zpracováváme…</p>
    <p><a href={url('/')}>Zpět na úvod</a></p>
  </section>
</BaseLayout>

<script>
  import { odeslat } from '../../lib/apps-script';
  const el = document.querySelector<HTMLElement>('[data-stav]')!;
  const p = new URLSearchParams(location.search);
  const t = p.get('t');
  if (!el.dataset.url || !t) {
    el.textContent = `Odkaz je neúplný. Napište nám prosím na ${el.dataset.email}.`;
  } else {
    odeslat(el.dataset.url, { akce: el.dataset.akce, t })
      .then((r) => (el.textContent = r.ok ? el.dataset.ok! : r.zprava ?? 'Odkaz už neplatí.'))
      .catch(() => (el.textContent = `Něco se nepovedlo. Napište nám prosím na ${el.dataset.email}.`));
  }
</script>
