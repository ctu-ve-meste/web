---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import { getImage } from 'astro:assets';
import Gallery from '../../components/Gallery.astro';
import { vsechnyAkce, chronologicky } from '../../lib/akce';
import { rozsah, isoDatum } from '../../lib/datum';
import { absUrl, url } from '../../lib/url';

export async function getStaticPaths() {
  const rocniky = await getCollection('rocniky');
  return rocniky.map((r) => ({ params: { rok: String(r.data.rok) }, props: { rocnik: r } }));
}
const { rocnik } = Astro.props as { rocnik: CollectionEntry<'rocniky'> };
const r = rocnik.data;
const akce = chronologicky((await vsechnyAkce()).filter((a) => a.data.rocnik?.id === rocnik.id));
const og = r.fotky[0] ? (await getImage({ src: r.fotky[0].src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const mesta = (await Promise.all(r.mesta.map((m) => getEntry(m)))).filter((m) => !!m);
const festival = {
  '@context': 'https://schema.org',
  '@type': 'Festival',
  name: `Čtu ve městě ${r.rok} (${r.cislo}. ročník)`,
  url: absUrl(`/rocniky/${r.rok}/`, Astro.site),
  ...(r.od && { startDate: isoDatum(r.od) }),
  ...(r.do && { endDate: isoDatum(r.do) }),
  isAccessibleForFree: true,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: 'Frýdek-Místek', address: { '@type': 'PostalAddress', addressLocality: 'Frýdek-Místek', addressCountry: 'CZ' } },
  organizer: { '@type': 'Organization', name: 'Čtu ve městě, z.s.' },
  subEvent: akce.map((a) => ({ '@type': 'Event', name: a.data.title, url: absUrl(`/akce/${a.id}/`, Astro.site) })),
};
---
<BaseLayout title={`${r.cislo}. ročník ${r.rok}`} description={`${r.cislo}. ročník festivalu Čtu ve městě ${r.rok}. ${r.perex}`} accent={r.barva} jsonLd={festival} image={og} imageAlt={r.fotky[0]?.alt}>
  <section class="container section">
    <SectionHeading as="h1" label={`${r.cislo}. ROČNÍK${r.od ? ` · ${rozsah(r.od, r.do)}` : ''}`} spines>{String(r.rok)}</SectionHeading>
    <p class="lead prose">{r.perex}</p>
    {(mesta.length > 0 || r.dalsiMesta.length > 0) && (
      <p>
        <span class="label muted">Města: </span>
        {mesta.map((m, i) => <>{i > 0 && ', '}{m.data.aktivni ? <a href={url(`/mesta/${m.id}/`)}>{m.data.nazev}</a> : m.data.nazev}</>)}
        {r.dalsiMesta.length > 0 && <>{mesta.length > 0 && ', '}{r.dalsiMesta.join(', ')}</>}
      </p>
    )}
  </section>

  {r.fotky.length > 0 && (
    <section class="container section">
      <SectionHeading label="FOTKY">Takhle to vypadalo</SectionHeading>
      <Gallery fotky={r.fotky} nazev={`Fotky ${r.rok}`} />
    </section>
  )}

  {akce.length > 0 && (
    <section class="container section">
      <SectionHeading label="AKCE">Co se četlo</SectionHeading>
      <ul class="grid" role="list">{akce.map((a) => <li><EventCard akce={a} /></li>)}</ul>
    </section>
  )}

  {r.plakaty.length > 0 && (
    <section class="container section">
      <SectionHeading label="KE STAŽENÍ">Plakáty</SectionHeading>
      <ul class="plakaty" role="list">
        {r.plakaty.map((p) => (
          <li><a class="btn btn--ghost" href={url(`/plakaty/${r.rok}/${p.soubor}`)} download>{p.nazev} <span class="muted">({p.soubor.split('.').pop()?.toUpperCase()})</span></a></li>
        ))}
      </ul>
    </section>
  )}

  {r.partneri.length > 0 && (
    <section class="container section">
      <SectionHeading label="PARTNEŘI">Kdo nám pomohl</SectionHeading>
      <ul class="partneri" role="list">
        {r.partneri.map((p) => <li>{p.url ? <a href={p.url} rel="noopener">{p.nazev}</a> : p.nazev}</li>)}
      </ul>
    </section>
  )}

</BaseLayout>

<style>
  .lead { font-size: var(--fs-lead); }
  .plakaty, .partneri { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .partneri li { padding: var(--space-2) var(--space-3); border: 1px solid currentColor; border-radius: 999px; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
