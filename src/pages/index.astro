---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import BookSpines from '../components/BookSpines.astro';
import BigNumber from '../components/BigNumber.astro';
import RocnikList from '../components/RocnikList.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { vsechnyAkce, nadchazejici } from '../lib/akce';
import { aktualniRocnik, vsechnyRocniky } from '../lib/rocniky';
import { rozsah } from '../lib/datum';
import { url } from '../lib/url';
import { config } from '../config';

const stranka = (await getEntry('stranky', 'uvod'))!;
const { Content } = await render(stranka);
const rocnik = await aktualniRocnik();
const r = rocnik.data;
const vse = await vsechnyAkce();
const budouci = nadchazejici(vse).slice(0, 3);
const karty = budouci.length ? budouci : vse.filter((a) => a.data.cover).slice(0, 3);
// Velká fotka: první výběrová fotka nejnovějšího ročníku, který nějakou má.
const sFotkou = (await vsechnyRocniky()).find((x) => x.data.fotky.length > 0);
const velkaFotka = sFotkou?.data.fotky[0];
const partneri = (await getCollection('partneri', (p) => !p.data.proDospele)).sort((a, b) => a.data.poradi - b.data.poradi);
---
<BaseLayout title={stranka.data.title} description={stranka.data.description}>
  <section class="hero">
    <BookSpines varianta="vypln" radku={7} class="hero__bg" />
    <div class="container hero__inner">
      <p class="label hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {budouci.length
          ? `Nejbližší akce: ${budouci[0].data.title}`
          : `${r.cislo}. ročník ${r.rok} se připravuje${r.od ? ` · ${rozsah(r.od, r.do)}` : ''}`}
      </p>
      <h1 class="hero__title">Festival, kde hvězdy nic nepředvádějí. Jen čtou<span class="dot" aria-hidden="true">.</span></h1>
      <p class="hero__cta">
        {budouci.length ? (
          <a class="btn" href={url('/program/')}>Program</a>
        ) : (
          <a class="btn" href={config.site.instagram} rel="noopener">Sledujte nás na Instagramu</a>
        )}
        <a class="btn btn--ghost" href={url('/akce/')}>Co jsme už přečetli</a>
      </p>
    </div>
  </section>

  {velkaFotka && sFotkou && (
    <figure class="velka-fotka">
      <Image src={velkaFotka.src} alt={velkaFotka.alt} widths={[800, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <figcaption class="container small muted">{velkaFotka.alt} · <a href={url(`/rocniky/${sFotkou.data.rok}/`)}>{sFotkou.data.cislo}. ročník {sFotkou.data.rok}</a></figcaption>
    </figure>
  )}

  <section class="container section reveal co-to-je">
    <div>
      <SectionHeading label="CO TO JE" spines>Hvězdy jsou čtenáři</SectionHeading>
      <div class="prose lead"><Content /></div>
      <p class="motto">sedni si, čti,<br />buď vidět<span class="dot" aria-hidden="true">.</span></p>
    </div>
    <RocnikList />
  </section>

  <section class="container section reveal">
    <SectionHeading label={budouci.length ? 'NEJBLIŽŠÍ AKCE' : 'NAPOSLEDY JSME ČETLI'}>
      {budouci.length ? 'Přijďte si číst' : 'Takhle to vypadalo'}
    </SectionHeading>
    <ul class="grid-cards" role="list">
      {karty.map((a) => <li><EventCard akce={a} /></li>)}
    </ul>
    <p class="vice"><a href={url('/akce/')}>Všechny akce <span aria-hidden="true">→</span></a></p>
  </section>

  {stranka.data.cisla.length > 0 && (
    <section class="container section reveal">
      <SectionHeading label="V ČÍSLECH">Nápad porazil rozpočet</SectionHeading>
      <div class="cisla">
        {stranka.data.cisla.map((c) => <BigNumber hodnota={c.hodnota} popis={c.popis} />)}
      </div>
    </section>
  )}

  <section class="container section reveal">
    <SectionHeading label="PŘIDEJTE SE">A příští rok můžou číst i u vás</SectionHeading>
    <p class="prose lead">Chcete, aby se četlo i u vás? Stačí místo k sezení a někdo, kdo si sedne první.</p>
    <p><a class="btn" href={url('/pridejte-se/')}>Jak se přidat</a></p>
  </section>

  <section class="container section reveal" id="newsletter">
    <SectionHeading label="NEWSLETTER">Novinky pro čtenáře</SectionHeading>
    <p class="prose">Program, nové akce a pozvánky vám pošleme e-mailem.</p>
    <NewsletterForm id="uvod-newsletter" />
  </section>

  <section class="container section partneri" aria-labelledby="partneri-nadpis">
    <p class="label muted" id="partneri-nadpis">Děkujeme partnerům</p>
    <ul role="list">
      {partneri.map((p) => <li>{p.data.url ? <a href={p.data.url} rel="noopener">{p.data.nazev}</a> : p.data.nazev}</li>)}
    </ul>
    <p><a href={url('/partneri/')}>Partneři festivalu <span aria-hidden="true">→</span></a></p>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero :global(.hero__bg) { position: absolute; inset: 0; pointer-events: none; }
  .hero__inner { position: relative; padding-block: var(--space-5) var(--space-6); }
  .hero__status { display: flex; align-items: center; gap: var(--space-2); }
  .hero__dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent); flex: none; }
  .hero__title { max-width: 14ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .velka-fotka { margin: 0; }
  .velka-fotka :global(img) { width: 100%; height: min(80vh, 56rem); object-fit: cover; }
  .velka-fotka figcaption { padding-top: var(--space-2); }
  .small { font-size: var(--fs-small); }
  .motto { font-family: var(--font-head); font-weight: 700; font-size: var(--fs-h2); line-height: 1.1; margin-top: var(--space-5); }
  .vice { margin-top: var(--space-4); }
  .cisla { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .co-to-je { display: grid; gap: var(--space-6); }
  .partneri { border-top: var(--border); }
  .partneri ul { list-style: none; padding: 0; margin: var(--space-3) 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-family: var(--font-head); font-weight: 700; font-size: var(--fs-lead); }
  .partneri ul a { text-decoration: none; }
  .partneri ul a:hover { color: var(--accent); }
  @media (min-width: 64rem) { .co-to-je { grid-template-columns: 3fr 2fr; align-items: end; } }
</style>
