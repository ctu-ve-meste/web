---
import Logo from './Logo.astro';
import BookSpines from './BookSpines.astro';
import { config, paticka } from '../config';
import { url } from '../lib/url';
const rok = new Date().getFullYear();
---
<footer class="site-footer">
  <BookSpines varianta="pas" class="site-footer__spines" />
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={url('/')} aria-label="Čtu ve městě – úvod"><Logo varianta="rocnik" /></a>
    </div>
    {paticka.map((s) => (
      <nav aria-label={s.nadpis}>
        <p class="label">{s.nadpis}</p>
        <ul>
          {s.odkazy.map((o) => <li><a href={url(o.href)}>{o.text}</a></li>)}
        </ul>
      </nav>
    ))}
    <div>
      <p class="label">Kontakt</p>
      <p>
        <a href={`mailto:${config.email}`} class="site-footer__link">{config.email}</a>
      </p>
      <p class="site-footer__socky">
        <a href={config.site.instagram} rel="noopener" class="site-footer__link">Instagram</a>
        <a href={config.site.facebook} rel="noopener" class="site-footer__link">Facebook</a>
      </p>
      <p class="muted small">
        {config.spolek.nazev}<br />
        {config.spolek.ulice}, <span class="nowrap">{config.spolek.psc} {config.spolek.mesto}</span><br />
        IČ {config.spolek.ico}
      </p>
    </div>
  </div>
  <div class="container site-footer__bottom muted small">
    <p>© {rok} {config.spolek.nazev} · sedni si, čti, buď vidět<span class="dot" aria-hidden="true">.</span></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--gray-2);
    margin-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .site-footer__spines { color: var(--gray-3); }
  .site-footer__grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
    grid-template-columns: 1fr 1fr;
    padding-block: var(--space-5);
  }
  .site-footer__brand { width: 9rem; grid-column: 1 / -1; }
  .site-footer__grid > div:last-child { grid-column: 1 / -1; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin-bottom: var(--space-2); }
  .site-footer li a { text-decoration: none; }
  .site-footer li a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .small { font-size: var(--fs-small); }
  .site-footer__link { display: inline-block; padding-block: var(--space-2); }
  a.site-footer__link[href^='mailto:'] { font-size: var(--fs-small); }
  .site-footer__socky { display: flex; gap: var(--space-4); }
  .site-footer__bottom p { margin: 0; }
  @media (min-width: 64rem) {
    .site-footer__grid { grid-template-columns: 1.2fr repeat(4, 1fr); }
    .site-footer__brand, .site-footer__grid > div:last-child { grid-column: auto; }
  }
</style>
