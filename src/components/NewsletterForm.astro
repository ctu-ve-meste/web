---
/**
 * Přihlášení k newsletteru: obyčejný formulář (POST) na web app newsletteru (config.appsScriptUrl),
 * který vyřídí handleSignup_ v Code.gs (potvrzovací e-mail, double opt-in). Funguje i bez JavaScriptu.
 * Ochrana proti spamu: skryté pole (honeypot) + čas načtení stránky `ts`. Žádná reCAPTCHA.
 * Když URL web appu není nastavená, ukáže se náhradní odkaz na e-mail.
 */
import { config } from '../config';
import { url } from '../lib/url';
interface Props { id?: string; kompaktni?: boolean }
const { id = 'newsletter', kompaktni = false } = Astro.props;
const souhlasText = 'Souhlasím se zpracováním e-mailu pro zasílání newsletteru spolku Čtu ve městě, z.s.';
---
{config.appsScriptUrl ? (
  <form class:list={['nl', { 'nl--kompaktni': kompaktni }]} method="post" action={config.appsScriptUrl} data-newsletter>
    <input type="hidden" name="a" value="signup" />
    <input type="hidden" name="ts" value="0" />
    <div class="field">
      <label for={`${id}-email`}>Váš e-mail</label>
      <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="120" placeholder="jmeno@example.cz" />
    </div>
    <div class="nl__hp" aria-hidden="true">
      <label for={`${id}-web`}>Nevyplňujte</label>
      <input id={`${id}-web`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <label class="check">
      <input type="checkbox" id={`${id}-souhlas`} name="consent" required value="1" />
      <span>{souhlasText} Více v <a href={url('/ochrana-osobnich-udaju/')}>zásadách ochrany osobních údajů</a>.</span>
    </label>
    <p><button class="btn" type="submit">Přihlásit se</button></p>
    <p class="muted small">Po odeslání vám přijde e-mail, ve kterém odběr potvrdíte.</p>
  </form>
) : (
  <p class="prose">
    Přihlašování k newsletteru spouštíme. Do té doby nám napište na{' '}
    <a href={`mailto:${config.emailNewsletter}?subject=Chci%20newsletter`}>{config.emailNewsletter}</a> a přidáme vás.
  </p>
)}

<script>
  // čas načtení stránky: příliš rychlé odeslání (robot) newsletter ignoruje
  document.querySelectorAll<HTMLInputElement>('[data-newsletter] input[name=ts]').forEach((i) => { i.value = String(Date.now()); });
</script>

<style>
  .nl { max-width: var(--max-w-text); }
  .nl__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .small { font-size: var(--fs-small); }
</style>
