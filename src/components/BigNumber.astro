---
/** Velké číslo z pitche (~1000, 84 %, 11×, +3) s popiskem. */
interface Props { hodnota: string; popis: string; detail?: string }
const { hodnota, popis, detail } = Astro.props;
---
<div class="big-number">
  <p class="big-number__hodnota">{hodnota}</p>
  <p class="big-number__popis">{popis}{detail && <span class="muted"> {detail}</span>}</p>
</div>

<style>
  .big-number { border-top: var(--border); padding-top: var(--space-4); }
  .big-number__hodnota {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--fs-number);
    line-height: 0.95;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin: 0 0 var(--space-3);
  }
  .big-number__popis { margin: 0; max-width: 30ch; }
</style>
