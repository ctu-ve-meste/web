---
import Logo from './Logo.astro';
import { navigace, navigaceTlacitko } from '../config';
import { url } from '../lib/url';

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__logo" aria-label="Čtu ve městě – úvod">
      <Logo varianta="zakladni" />
    </a>

    <nav class="site-nav" aria-label="Hlavní navigace">
      <ul class="site-nav__list">
        {navigace.map((n) => (
          <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.text}</a></li>
        ))}
      </ul>
    </nav>
    <a href={url(navigaceTlacitko.href)} class="btn site-header__cta">{navigaceTlacitko.text}</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-toggle__text">Menu</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Hlavní navigace (mobil)" class="container">
      <ul>
        {navigace.map((n) => (
          <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.text}<span class="dot">.</span></a></li>
        ))}
      </ul>
      <a href={url(navigaceTlacitko.href)} class="btn">{navigaceTlacitko.text}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.menu-toggle__text')!.textContent = open ? 'Zavřít' : 'Menu';
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--gray-2);
  }
  .site-header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .site-header__logo { width: 4.5rem; flex: none; }
  .site-nav { display: none; margin-left: auto; }
  .site-nav__list {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    font-family: var(--font-head);
    font-weight: 700;
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }
  .site-nav a[aria-current='page'] { border-bottom-color: var(--accent); }
  .site-header__cta { display: none; }
  .menu-toggle {
    margin-left: auto;
    background: none;
    border: 2px solid var(--fg);
    color: var(--fg);
    border-radius: 999px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.5em 1.1em;
    cursor: pointer;
    min-height: 44px;
  }
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--bg);
    overflow-y: auto;
    padding-block: var(--space-5);
  }
  .mobile-menu ul { list-style: none; margin: 0 0 var(--space-5); padding: 0; }
  .mobile-menu li a {
    display: block;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.2;
    text-decoration: none;
    padding-block: var(--space-1);
  }
  .mobile-menu li a[aria-current='page'] { color: var(--accent); }

  @media (min-width: 64rem) {
    .site-header__logo { width: 5.5rem; }
    .site-nav, .site-header__cta { display: flex; }
    .menu-toggle, .mobile-menu { display: none; }
  }
</style>
