---
import Logo from './Logo.astro';
import { config, navigace, navigaceTlacitko } from '../config';
import { url } from '../lib/url';

interface Props {
  /** Přepíše config.logoZahlavi (používá /styleguide/). */
  logo?: 'rozsirene' | 'zakladni';
  /** Ukázka na styleguide: nelepí se nahoru, bez mobilního menu. */
  demo?: boolean;
}
const { logo = config.logoZahlavi, demo = false } = Astro.props;
const current = Astro.url.pathname;
const isActive = (href: string) => !demo && current.startsWith(url(href));
---
<header class:list={['site-header', `site-header--${logo}`, { 'site-header--demo': demo }]} data-header={demo ? undefined : ''}>
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__logo" aria-label="Čtu ve městě – úvod">
      <Logo varianta="zakladni" class="site-header__logo-zakladni" />
      {logo === 'rozsirene' && <Logo varianta="rozsirene" class="site-header__logo-rozsirene" />}
    </a>

    <nav class="site-nav" aria-label="Hlavní navigace">
      <ul class="site-nav__list">
        {navigace.map((n) => (
          <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.text}</a></li>
        ))}
      </ul>
    </nav>
    <a href={url(navigaceTlacitko.href)} class="btn site-header__cta">{navigaceTlacitko.text}</a>

    {!demo && (
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-toggle__text">Menu</span>
      </button>
    )}
  </div>

  {!demo && (
    <div id="mobile-menu" class="mobile-menu" hidden>
      <nav aria-label="Hlavní navigace (mobil)" class="container">
        <ul>
          {navigace.map((n) => (
            <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.text}<span class="dot" aria-hidden="true">.</span></a></li>
          ))}
        </ul>
        <a href={url(navigaceTlacitko.href)} class="btn">{navigaceTlacitko.text}</a>
        <p class="mobile-menu__dalsi">
          <a href={config.site.instagram} rel="noopener">Instagram</a>
          <a href={url('/newsletter/')}>Newsletter</a>
          <a href={url('/kafe-a-kniha/')}>Kafe&kniha</a>
        </p>
      </nav>
    </div>
  )}
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.menu-toggle__text')!.textContent = open ? 'Zavřít' : 'Menu';
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      // obsah pod menu vyřadit z klávesnice i čteček, dokud je menu otevřené
      document.querySelectorAll('main, footer, .skip-link').forEach((el) => el.toggleAttribute('inert', open));
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--gray-2);
  }
  .site-header--demo { position: relative; z-index: auto; border: var(--border); }
  .site-header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    transition: height 0.25s var(--ease);
  }
  .site-header__logo { width: 4.5rem; flex: none; display: block; }
  .site-header__logo :global(.site-header__logo-rozsirene) { display: none; }
  .site-nav { display: none; margin-left: auto; }
  .site-nav__list { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .site-nav a {
    font-family: var(--font-head);
    font-weight: 700;
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }
  .site-nav a[aria-current='page'] { border-bottom-color: var(--accent); }
  .site-header__cta { display: none; }
  .menu-toggle {
    margin-left: auto;
    background: none;
    border: 2px solid var(--fg);
    color: var(--fg);
    border-radius: 999px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.5em 1.1em;
    cursor: pointer;
    min-height: 44px;
  }
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--bg);
    overflow-y: auto;
    padding-block: var(--space-5);
  }
  .mobile-menu ul { list-style: none; margin: 0 0 var(--space-5); padding: 0; }
  .mobile-menu li a {
    display: block;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.2;
    text-decoration: none;
    padding-block: var(--space-1);
  }
  .mobile-menu li a[aria-current='page'] { color: var(--accent); }
  .mobile-menu__dalsi { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-5); font-family: var(--font-head); font-weight: 700; }
  .mobile-menu__dalsi a { padding-block: var(--space-2); }

  @media (min-width: 64rem) {
    .site-header__logo { width: 5.5rem; }
    .site-nav, .site-header__cta { display: flex; }
    .menu-toggle, .mobile-menu { display: none; }

    /* rozšířené logo: vyšší záhlaví nahoře stránky, po scrollu jen „čtu“ */
    .site-header--rozsirene .site-header__inner { height: 8.5rem; }
    .site-header--rozsirene .site-header__logo { width: 8.5rem; }
    .site-header--rozsirene .site-header__logo :global(.site-header__logo-zakladni) { display: none; }
    .site-header--rozsirene .site-header__logo :global(.site-header__logo-rozsirene) { display: block; }
    .site-header--rozsirene.is-scrolled .site-header__inner { height: var(--header-h); }
    .site-header--rozsirene.is-scrolled .site-header__logo { width: 5.5rem; }
    .site-header--rozsirene.is-scrolled .site-header__logo :global(.site-header__logo-zakladni) { display: block; }
    .site-header--rozsirene.is-scrolled .site-header__logo :global(.site-header__logo-rozsirene) { display: none; }
  }
</style>
