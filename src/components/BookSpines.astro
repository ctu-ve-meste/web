---
/**
 * Grafický prvek „hřbety knih“: lomítka a svislé čáry /|||/||/||||/.
 * varianta: 'pas' (řádek přes celou šířku), 'doplnek' (malý vedle nadpisu),
 * 'vypln' (několik řádků jako pozadí hero), 'karta' (řádek na zástupném obrázku karty akce,
 * barva z --rocnik; vzor a počet opakování jdou zadat přes `vzor` a `opakovani`).
 * Sazba písmem Bricolage, ne obrázek. Vždy aria-hidden a user-select: none: čtečky ho
 * nepředčítají a při kopírování textu se nekopíruje. Dekor tedy vždy vykreslujte jen tímhle
 * komponentem, nikdy ho nepište do textu ručně.
 */
interface Props {
  varianta?: 'pas' | 'doplnek' | 'vypln' | 'karta';
  vzor?: string;
  opakovani?: number;
  radku?: number;
  akcent?: boolean;
  class?: string;
}
const { varianta = 'pas', radku = 6, akcent = false, class: cls, vzor: vlastniVzor, opakovani = 1 } = Astro.props;
const vzor = '/|||/||/||||/||/|||/||/||||/||/';
const radek = (posun: number) => {
  const r = vzor.repeat(8);
  return r.slice(posun % vzor.length) + r.slice(0, posun % vzor.length);
};
const radky = varianta === 'vypln' ? Array.from({ length: radku }, (_, i) => radek(i * 4)) : [];
---
{varianta === 'karta' && (
  <span class:list={['spines spines--karta', cls]} aria-hidden="true">{(vlastniVzor ?? vzor).repeat(opakovani)}</span>
)}
{varianta === 'doplnek' && (
  <span class:list={['spines spines--doplnek', { 'spines--akcent': akcent }, cls]} aria-hidden="true">/|||/||/</span>
)}
{varianta === 'pas' && (
  <div class:list={['spines spines--pas', { 'spines--akcent': akcent }, cls]} aria-hidden="true">{radek(0)}</div>
)}
{varianta === 'vypln' && (
  <div class:list={['spines spines--vypln', { 'spines--akcent': akcent }, cls]} aria-hidden="true">
    {radky.map((r) => <div>{r}</div>)}
  </div>
)}

<style>
  .spines {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    color: var(--fg);
  }
  .spines--akcent { color: var(--accent); }
  .spines--doplnek {
    display: inline;
    vertical-align: baseline;
    font-size: 1.15em;
    line-height: 1;
    margin-left: 0.5em;
    letter-spacing: 0;
    color: var(--fg);
  }
  .spines--karta {
    overflow: visible;
    font-size: 2.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--rocnik);
    opacity: 0.55;
    padding-block: var(--space-2);
  }
  .spines--pas {
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    line-height: 1;
    padding-block: var(--space-3);
  }
  .spines--vypln {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4.5rem);
    line-height: 1;
    opacity: 0.1;
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 85%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 85%);
  }
</style>
